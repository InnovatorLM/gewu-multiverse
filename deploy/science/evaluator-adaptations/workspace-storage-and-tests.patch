index be67a0a..f121101 100644
--- a/unified_evaluator/runtime/core.py
+++ b/unified_evaluator/runtime/core.py
@@ -191,6 +191,31 @@ def runtime_root(path, task_dir):
     fs = subprocess.check_output(
         ["findmnt", "-n", "-o", "FSTYPE", "-T", str(path)], text=True, timeout=5
     ).strip()
+    explicitly_allowed = os.getenv("UE_VERIFIED_RUNTIME_ROOT")
+    if fs == "fuse.aliyun-alinas-efc" and explicitly_allowed:
+        # Restricted opt-in for this workspace; exercise actual database and
+        # atomic file operations rather than pretending the filesystem is local.
+        allowed = Path(explicitly_allowed).expanduser().resolve()
+        if path != allowed:
+            raise ValueError("Verified runtime root does not match requested path")
+        import sqlite3
+        with tempfile.TemporaryDirectory(prefix="storage-probe-", dir=path) as probe:
+            root = Path(probe)
+            source = root / "source"
+            source.write_text("probe")
+            source.replace(root / "target")
+            if (root / "target").read_text() != "probe":
+                raise ValueError("Runtime atomic replacement probe failed")
+            with sqlite3.connect(root / "state.sqlite", timeout=2) as db:
+                if db.execute("PRAGMA journal_mode=WAL").fetchone()[0] != "wal":
+                    raise ValueError("Runtime SQLite WAL probe failed")
+                db.execute("CREATE TABLE probe (value INTEGER)")
+                db.execute("INSERT INTO probe VALUES (1)")
+                db.commit()
+                if db.execute("PRAGMA integrity_check").fetchone()[0] != "ok":
+                    raise ValueError("Runtime SQLite integrity probe failed")
+            db.close()
+        return path
     if fs not in {"overlay", "ext4", "xfs", "btrfs", "tmpfs"}:
         raise ValueError(
             f"Runtime root must use a local filesystem, found {fs!r}: {path}"
