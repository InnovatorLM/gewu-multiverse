#!/bin/bash
# Root operator starts the broker; the UI/controller drops to nobody.
set -euo pipefail
set +x
W=/mnt/data/zhanglinfeng/workspace
PY="$W/acs-harbor-test/.venv/bin/python"
# Validate deployment identity before changing HOME or creating runtime paths.
U=$(PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$W/gewu-multiverse/deploy/science" \
    "$PY" -c 'from deployment_paths import universe_root,require_isolated_service_config; u=universe_root(); require_isolated_service_config(u); print(u)')
export GEWU_UNIVERSE_ROOT="$U"
export TMPDIR="$U/.tmp" PYTHONDONTWRITEBYTECODE=1
export XDG_CONFIG_HOME="$U/.config" XDG_STATE_HOME="$U/.state"
export XDG_DATA_HOME="$U/.local/share" XDG_CACHE_HOME="$U/.cache"
export HOME="$U/.local/home" GIT_CONFIG_GLOBAL="$U/.config/gitconfig"
export GEWU_HARNESS=native
export GEWU_SESSION_TIMEOUT_SECS=14400
export GEWU_RESPONSE_TOKENS=8192
export GEWU_CHAT_THINKING=disabled
export GEWU_FORGEJO_TIMEOUT_SECS=120
export GEWU_ROLE_BROKER_CONFIG="$U/.state/gewu-multiverse/role-broker/config.json"
# Use the workspace-designated DawnFM account for every live model request.
# Load quietly; the key remains only in this process environment, never in the
# universe's persisted credentials or logs.
LLM_ENV="$W/.config/llm/dawnfm.env"
[[ -f "$LLM_ENV" && ! -L "$LLM_ENV" && $(stat -c '%a' "$LLM_ENV") == 600 ]] || {
    echo 'Designated model credential file is missing or has unsafe permissions.' >&2; exit 1;
}
[[ $(stat -c '%a' "$(dirname "$LLM_ENV")") == 700 ]] || {
    echo 'Designated model credential directory has unsafe permissions.' >&2; exit 1;
}
set -a
source "$LLM_ENV"
set +a
export GEWU_LIVE_MODEL_TEST=1
[[ "$LLM_PROVIDER" == dawnfm && "$OPENAI_BASE_URL" == https://dawnfm.gravarc.cn/v1 && \
   "$OPENAI_MODEL" == deepseek-v4.1-flash-1017 && -n "$OPENAI_API_KEY" ]] || {
    echo 'Designated live model account configuration is invalid.' >&2; exit 1;
}
# All operator services and role-side Forgejo tools use the port recorded in
# this universe's instance.  The local-runtime launcher may choose a free
# loopback port, so no service may assume 3000.
FORGEJO_PORT=$("$PY" - "$U/.local/share/gewu-multiverse/forgejo/instance/app.ini" <<'PY'
import re,sys
text=open(sys.argv[1]).read()
m=re.search(r'^HTTP_PORT\s*=\s*(\d+)\s*$',text,re.M)
if not m: raise SystemExit('Forgejo HTTP_PORT is missing')
print(m.group(1))
PY
)
export GEWU_FORGEJO_URL="http://127.0.0.1:${FORGEJO_PORT}"
SERVICE_STATE="$U/.state/gewu-multiverse"
trap 'startup_code=$?; printf "{\"phase\":\"services\",\"line\":%s,\"exit_code\":%s,\"launcher_pid\":%s}\n" "$LINENO" "$startup_code" "$$" > "$SERVICE_STATE/startup-failure.json"' ERR
QUEUE_CONFIG="$U/.config/science-evaluation/queue.json"
QUEUE_STATE="$SERVICE_STATE/evaluation-queue"
PRODUCT="$W/.local/libexec/gewu-multiverse"
# Reuse the preinstalled workspace binary for fresh universes. The product's
# installer still verifies its pinned SHA256 before accepting the local file.
if [[ -z "${GEWU_FORGEJO_BINARY:-}" && -r "$W/.local/share/gewu-multiverse/forgejo/forgejo-17.0.0-linux-amd64" ]]; then
    export GEWU_FORGEJO_BINARY="$W/.local/share/gewu-multiverse/forgejo/forgejo-17.0.0-linux-amd64"
fi
if [[ $(id -u) != 0 ]]; then
    echo 'Start this deployment as the root operator; its controller drops privileges.' >&2
    exit 1
fi
[[ -f "$GEWU_ROLE_BROKER_CONFIG" && -x "$PRODUCT" ]]
# Keep this descriptor for the whole launcher lifetime, including owned children.
# An operator reset holds the exclusive side and startup must fail closed.
mkdir -p "$SERVICE_STATE/role-reset"
exec 9>>"$SERVICE_STATE/role-reset/lifecycle.lock"
chmod 600 "$SERVICE_STATE/role-reset/lifecycle.lock"
flock -s -n 9 || { echo 'Operator maintenance/reset is active; deployment not started.' >&2; exit 1; }
# Install only while holding the deployment lifecycle lock, before roles run.
PYTHONPATH="$W/gewu-multiverse/deploy/science${PYTHONPATH:+:$PYTHONPATH}" \
"$PY" - "$GEWU_ROLE_BROKER_CONFIG" <<'PY_BATCH_CLIENT'
import json,sys
from role_evaluation_batch import install_clients
install_clients(json.load(open(sys.argv[1])))
PY_BATCH_CLIENT
# Check existing recovery records under the same UID as the controller. A root
# maintenance rewrite must not leave private root-owned plans and silently
# block only those roles after the board starts.
setpriv --reuid=65534 --regid=65534 --clear-groups "$PY" \
    "$W/gewu-multiverse/deploy/science/controller_readability.py" "$SERVICE_STATE"
# Run import/tool probes as each enabled role before any controller can schedule it.
"$PY" "$W/gewu-multiverse/deploy/science/role_capabilities.py" \
    --config "$GEWU_ROLE_BROKER_CONFIG" --settings "$U/.config/gewu-multiverse/multiverse.toml"
mkdir -p "$(dirname "$GEWU_ROLE_BROKER_CONFIG")"
"$PY" "$W/gewu-multiverse/deploy/science/role_exec.py" "$GEWU_ROLE_BROKER_CONFIG" \
    > "$SERVICE_STATE/role-broker/production-broker.log" 2>&1 &
broker_pid=$!
evaluation_pid=''
review_dispatch_pid=''
selftest_pid=''
watchdog_pid=''
controller_pid=''
finish() {
    if [[ -n "$controller_pid" ]]; then
        kill -TERM "$controller_pid" 2>/dev/null || true
        wait "$controller_pid" 2>/dev/null || true
    fi
    if [[ -n "$watchdog_pid" ]]; then
        kill -TERM "$watchdog_pid" 2>/dev/null || true
        wait "$watchdog_pid" 2>/dev/null || true
    fi
    if [[ -n "$selftest_pid" ]]; then
        kill -TERM "$selftest_pid" 2>/dev/null || true
        wait "$selftest_pid" 2>/dev/null || true
    fi
    if [[ -n "$review_dispatch_pid" ]]; then
        kill -TERM "$review_dispatch_pid" 2>/dev/null || true
        wait "$review_dispatch_pid" 2>/dev/null || true
    fi
    if [[ -n "$evaluation_pid" ]]; then
        kill -TERM "$evaluation_pid" 2>/dev/null || true
        wait "$evaluation_pid" 2>/dev/null || true
    fi
    kill -TERM "$broker_pid" 2>/dev/null || true
    wait "$broker_pid" 2>/dev/null || true
    rm -f "$SERVICE_STATE/controller.pid"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Verify the process we own is live, then authenticate the real controller UID
# before opening the board. A duplicate broker or broken root fails closed.
"$PY" - "$broker_pid" <<'PY_CHECK'
import json, os, socket, struct, sys, time
from pathlib import Path
config=json.loads(Path(os.environ['GEWU_ROLE_BROKER_CONFIG']).read_text())
address='\0'+config['socket'][1:] if config['socket'].startswith('@') else config['socket']
deadline=time.monotonic()+10
while True:
    try:
        os.kill(int(sys.argv[1]),0)
        with socket.socket(socket.AF_UNIX) as s:
            s.settimeout(1)
            s.connect(address)
            peer_pid, peer_uid, _ = struct.unpack('3i',s.getsockopt(socket.SOL_SOCKET,socket.SO_PEERCRED,12))
            if peer_pid != int(sys.argv[1]) or peer_uid != 0:
                raise SystemExit('Socket belongs to another broker; controller not started')
        break
    except (ProcessLookupError, ConnectionRefusedError, FileNotFoundError):
        if time.monotonic()>deadline:
            raise SystemExit('Role broker failed startup; controller not started')
        time.sleep(0.1)
PY_CHECK
QUEUE_READY="$QUEUE_STATE/ready.json"
mkdir -p "$QUEUE_STATE"
"$PY" "$W/gewu-multiverse/deploy/science/evaluation_queue.py" \
    --config "$QUEUE_CONFIG" --ready-file "$QUEUE_READY" \
    > "$QUEUE_STATE/production-worker.log" 2>&1 &
evaluation_pid=$!
"$PY" - "$evaluation_pid" "$QUEUE_READY" <<'PY_QUEUE_CHECK'
import errno, json, os, stat, sys, time
from pathlib import Path
pid=int(sys.argv[1]); path=Path(sys.argv[2]); deadline=time.monotonic()+15
while True:
    try:
        os.kill(pid,0)
        info=path.lstat()
        if stat.S_ISREG(info.st_mode) and info.st_uid==0 and not info.st_mode & 0o022 and json.loads(path.read_text()).get('pid')==pid:
            break
    except (ProcessLookupError, FileNotFoundError, json.JSONDecodeError):
        pass
    except OSError as error:
        # Shared storage can invalidate a ready-file handle during replacement.
        # Reopen within the existing deadline; permission and other errors fail.
        if error.errno != errno.ESTALE:
            raise
    if time.monotonic()>deadline:
        raise SystemExit('Evaluation worker failed startup; controller not started')
    time.sleep(0.1)
PY_QUEUE_CHECK
"$PY" "$W/gewu-multiverse/deploy/science/review_dispatcher.py" \
    --config "$GEWU_ROLE_BROKER_CONFIG" --state "$SERVICE_STATE/review-dispatcher" \
    > "$SERVICE_STATE/review-dispatcher/production.log" 2>&1 &
review_dispatch_pid=$!
"$PY" "$W/gewu-multiverse/deploy/science/author_selftest_worker.py" \
    --broker-config "$GEWU_ROLE_BROKER_CONFIG" --state "$SERVICE_STATE/author-selftest" \
    > "$SERVICE_STATE/author-selftest/production-worker.log" 2>&1 &
selftest_pid=$!
mkdir -p "$SERVICE_STATE/command-watchdog"
"$PY" "$W/gewu-multiverse/deploy/science/command_watchdog.py" \
    --config "$GEWU_ROLE_BROKER_CONFIG" --state "$SERVICE_STATE/command-watchdog" --session-state "$SERVICE_STATE" \
    > "$SERVICE_STATE/command-watchdog/production.log" 2>&1 &
watchdog_pid=$!
# Refuse a controller start if any owned background service already failed.
for service_pid in "$broker_pid" "$evaluation_pid" "$review_dispatch_pid" "$selftest_pid" "$watchdog_pid"; do
    kill -0 "$service_pid" || { echo 'A required deployment service exited during startup.' >&2; exit 1; }
done
export USER=nobody LOGNAME=nobody
if [[ -t 0 && -t 1 ]]; then
    setpriv --reuid=65534 --regid=65534 --clear-groups "$PRODUCT" "$@" </dev/tty >/dev/tty &
else
    echo 'The universe controller requires a terminal; start it from an interactive shell.' >&2
    exit 2
fi
controller_pid=$!
printf '%s\n' "$controller_pid" > "$SERVICE_STATE/controller.pid"
wait "$controller_pid"
