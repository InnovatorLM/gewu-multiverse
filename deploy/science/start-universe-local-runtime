#!/usr/bin/env bash
# Run a universe with hot state in the workspace-local scratch tree; the
# stopped universe receives periodic archives only.  Keeping this below the
# workspace is required by the deployment storage policy and also makes the
# runtime discoverable during backup and recovery.
set -euo pipefail
W=/mnt/data/zhanglinfeng/workspace
PY="$W/acs-harbor-test/.venv/bin/python"
export PYTHONPATH="$W/gewu-multiverse/deploy/science${PYTHONPATH:+:$PYTHONPATH}"
export GEWU_FORGEJO_PORT
SOURCE=${GEWU_UNIVERSE_SOURCE:-$W/universes/my-terminal-bench-science-v2}
DONOR=${GEWU_EXTERNAL_ROLE_ROOTS:-$W/universes/my-terminal-bench-science}
RUNTIME=${GEWU_LOCAL_RUNTIME_ROOT:-$W/.tmp/gewu-terminal-bench-science-runtime}
BACKUP_DIR=${GEWU_BACKUP_DIR:-$W/.state/backups/live}
mkdir -p "$RUNTIME" "$BACKUP_DIR"
# Keep only failure location and status, never terminal output or command text.
# The controlling PTY intentionally discards screens which may contain secrets.
trap 'startup_code=$?; printf "{\"phase\":\"local-runtime\",\"line\":%s,\"exit_code\":%s,\"launcher_pid\":%s}\n" "$LINENO" "$startup_code" "$$" > "$RUNTIME/startup-failure.json"' ERR
LOCAL_PORT=$(python3 - "$RUNTIME" "${GEWU_FORGEJO_PORT:-}" <<'PY'
import sys
from deployment_paths import ensure_runtime_forgejo_port,select_forgejo_port
port=select_forgejo_port(sys.argv[1],sys.argv[2] or None)
ensure_runtime_forgejo_port(sys.argv[1],port)
print(port)
PY
)
# Copy only small, authoritative configuration and role workspace metadata.
mkdir -p "$RUNTIME/.config/gewu-multiverse" "$RUNTIME/.config/science-evaluation" "$RUNTIME/workspaces"
mkdir -p "$RUNTIME/.config/gewu-multiverse/agents"
mkdir -p "$RUNTIME/.state/gewu-multiverse"
# CPFS may briefly expose a stale handle after another process rewrites a small
# control file. Retry bounded copies before declaring the deployment broken.
copy_control() {
  local src="$1" dst="$2" attempt
  for attempt in 1 2 3 4 5 6 7 8; do
    if timeout 10 cp "$src" "$dst" 2>/dev/null; then return 0; fi
    sleep "0.$((attempt + 1))"
  done
  return 1
}
# Avoid recursive CPFS directory walks. These are the only configuration files
# required by the launcher; each copy is bounded independently.
for f in "$DONOR/.config/gewu-multiverse/credentials.toml" \
         "$SOURCE/.config/gewu-multiverse/multiverse.toml" \
         "$SOURCE/.config/gewu-multiverse/last-seen.toml" \
         "$SOURCE/.config/gewu-multiverse/import-terminal-bench-science.repo-id" \
         "$SOURCE/.config/science-evaluation/queue.json" \
         "$SOURCE/.config/science-evaluation/registry.json"; do
  # The live controller owns its saved Start/Stop choices. Seed these once;
  # restarting must not silently restore the stopped donor's old selection.
  if [[ "$f" = */multiverse.toml && -f "$RUNTIME/.config/gewu-multiverse/multiverse.toml" ]]; then
    continue
  fi
  [ -f "$f" ] && copy_control "$f" "$RUNTIME/.config/${f#*/.config/}" || true
done

# Copy and rewrite the small service descriptors.  The old implementation
# copied only the queue TOML/JSON and then tried to read a broker descriptor
# which had never been created in the local runtime.  A fresh runtime
# therefore failed before the controller could start.  Mutable state and
# service descriptors belong to this runtime; role roots remain explicit,
# identity-isolated external roots under DONOR.
python3 - "$SOURCE" "$RUNTIME" "$DONOR" "$LOCAL_PORT" <<'PY'
import json
import sys
from pathlib import Path
from deployment_paths import broker_socket_name

source, runtime, donor = map(Path, sys.argv[1:4])
forgejo_url = 'http://127.0.0.1:' + sys.argv[4]
src_state = source / '.state/gewu-multiverse'
dst_state = runtime / '.state/gewu-multiverse'
dst_state.mkdir(parents=True, exist_ok=True)

broker = json.loads((src_state / 'role-broker/config.json').read_text())
broker['socket'] = broker_socket_name(runtime)
broker['_lock_dir'] = str(runtime / '.state/gewu-multiverse/role-broker/locks')
broker['_forgejo_url'] = forgejo_url
# The source descriptor may still refer to a retired donor universe.  Resolve
# each registered role by its name inside SOURCE, never by trusting that stale
# absolute path.  This keeps a hot runtime independent of the stopped
# universe's broker file.
for role, entry in broker['roles'].items():
    root = donor / '.config/gewu-multiverse/agents' / role
    if not root.is_dir():
        raise SystemExit(f'missing source role root: {role}')
    entry['root'] = str(root.resolve())
broker_path = dst_state / 'role-broker/config.json'
broker_path.parent.mkdir(parents=True, exist_ok=True)
broker_path.write_text(json.dumps(broker, indent=2) + '\n')

queue = json.loads((source / '.config/science-evaluation/queue.json').read_text())
queue['state'] = str(dst_state / 'evaluation-queue')
queue['registry'] = str(runtime / '.config/science-evaluation/registry.json')
for item in queue.get('role_queues', []):
    role = item.get('role')
    if role not in broker['roles']:
        raise SystemExit(f'queue role is not registered: {role}')
    role_root = Path(broker['roles'][role]['root'])
    item['inbox'] = str(role_root / 'evaluation/inbox')
    item['results'] = str(role_root / 'evaluation/results')
    inbox = Path(item['inbox'])
    results = Path(item['results'])
    inbox.mkdir(parents=True, exist_ok=True)
    results.mkdir(parents=True, exist_ok=True)
    uid = int(item['evaluator_uid'])
    import os
    inbox.chmod(0o700)
    inbox_owner = uid
    os.chown(inbox, inbox_owner, inbox_owner)
    results.chmod(0o755)
    os.chown(results, 0, 0)
queue_path = runtime / '.config/science-evaluation/queue.json'
queue_path.write_text(json.dumps(queue, indent=2) + '\n')

for name in ('review-dispatcher', 'author-selftest', 'command-watchdog'):
    src = src_state / name / 'config.json'
    payload = json.loads(src.read_text())
    payload['broker_config'] = str(broker_path)
    payload['state'] = str(dst_state / name)
    out = dst_state / name / 'config.json'
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(payload, indent=2) + '\n')

marker = json.loads((src_state / 'deployment.json').read_text())
marker['universe_root'] = str(runtime)
marker['role_root_donor'] = str(donor.resolve())
(dst_state / 'deployment.json').write_text(json.dumps(marker, indent=2) + '\n')
PY

# Seed all configured role instructions, not just the seven roles that happen
# to be enabled in one settings file.  The controller can enable another role
# later without silently falling back to a stale instruction.
python3 - "$SOURCE" "$RUNTIME" "$DONOR" <<'PY'
import json
import shutil
import sys
from pathlib import Path

source, runtime, donor = map(Path, sys.argv[1:])
broker = json.loads((runtime / '.state/gewu-multiverse/role-broker/config.json').read_text())
for role in broker['roles']:
    src = donor / '.config/gewu-multiverse/agents' / role / 'instruction.md'
    if not src.is_file():
        raise SystemExit(f'missing role instruction: {role}')
    dst = runtime / '.config/gewu-multiverse/agents' / role / 'instruction.md'
    dst.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(src, dst)
    # Native sessions discover and inject skills from the controller layout,
    # while shell tools see the donor chroot. Both must hold the same files.
    from install_role_skills import selected
    target_skills=dst.parent/'skills'
    if target_skills.is_symlink():
        raise SystemExit(f'linked controller skill directory: {role}')
    if target_skills.exists():
        shutil.rmtree(target_skills)
    target_skills.mkdir()
    for name in selected(role):
        origin=src.parent/'skills'/name
        if not (origin/'SKILL.md').is_file() or any(p.is_symlink() for p in [origin,*origin.rglob('*')]):
            raise SystemExit(f'missing or linked skill: {role}/{name}')
        shutil.copytree(origin,target_skills/name)
PY
# A hot runtime needs the Forgejo database, repository objects, and signing
# secrets that belong together.  Seeding only the TOML credentials creates a
# fresh owner-only Forgejo and makes every role's old token fail verification.
# Copy the stopped universe's instance once into local storage; subsequent
# starts reuse that local copy.  The source instance is never modified.
SOURCE_FORGEJO="$DONOR/.local/share/gewu-multiverse/forgejo/instance"
# A newly prepared universe may intentionally contain only configuration.  In
# that case recover the last stopped Forgejo instance, which carries the role
# accounts, ACLs, and imported repository database.
if [ ! -f "$SOURCE_FORGEJO/data/forgejo.db" ] || ! python3 - "$SOURCE_FORGEJO/data/forgejo.db" <<'PY'
import sqlite3
import sys
try:
    with sqlite3.connect('file:' + sys.argv[1] + '?mode=ro', uri=True) as db:
        ok = db.execute("select 1 from user where login_name = 'gewu-author-01' limit 1").fetchone()
except Exception:
    ok = None
raise SystemExit(0 if ok else 1)
PY
then
  SOURCE_FORGEJO="$SOURCE/.local/share/gewu-multiverse/forgejo/instance"
fi
LOCAL_FORGEJO="$RUNTIME/.local/share/gewu-multiverse/forgejo/instance"
if [ ! -f "$LOCAL_FORGEJO/data/forgejo.db" ] && [ -f "$SOURCE_FORGEJO/data/forgejo.db" ]; then
  mkdir -p "$LOCAL_FORGEJO"
  seed="$RUNTIME/.tmp/forgejo-seed-$$"
  mkdir -p "$seed"
  cp -a "$SOURCE_FORGEJO/data" "$seed/data"
  cp -a "$SOURCE_FORGEJO/secrets" "$seed/secrets"
  cp -a "$SOURCE_FORGEJO/home" "$seed/home" 2>/dev/null || true
  cp -a "$SOURCE_FORGEJO/app.ini" "$seed/app.ini"
  python3 - "$seed/app.ini" "$SOURCE_FORGEJO" "$LOCAL_FORGEJO" "$LOCAL_PORT" <<'PY'
from pathlib import Path
import re
import sys
p, old, new, port = Path(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
text = p.read_text()
text = text.replace(old, new)
text = re.sub(r'^HTTP_PORT\s*=\s*\d+', 'HTTP_PORT = ' + port, text, flags=re.M)
text = re.sub(r'^ROOT_URL\s*=\s*http://127\.0\.0\.1:\d+/', 'ROOT_URL = http://127.0.0.1:' + port + '/', text, flags=re.M)
p.write_text(text)
PY
  mv "$LOCAL_FORGEJO/data" "$LOCAL_FORGEJO/data.initial" 2>/dev/null || true
  mv "$seed/data" "$LOCAL_FORGEJO/data"
  mv "$seed/secrets" "$LOCAL_FORGEJO/secrets"
  mv "$seed/home" "$LOCAL_FORGEJO/home" 2>/dev/null || true
  mv "$seed/app.ini" "$LOCAL_FORGEJO/app.ini"
  rmdir "$seed" 2>/dev/null || true
fi
# The complete, versioned donor instructions were copied above. Do not replace
# them with onboarding templates: those omit skill discovery and delivery gates.
# Keep the controller's local layout connected to the already provisioned,
# identity-isolated chroot workspaces. The broker resolves these links before
# authorizing a command; no role can select another registered root.
python3 - "$RUNTIME/.config/gewu-multiverse/agents" "$RUNTIME/.state/gewu-multiverse/role-broker/config.json" <<'PY'
import json, os, sys
from pathlib import Path
agents, config = Path(sys.argv[1]), json.loads(Path(sys.argv[2]).read_text())
for name, entry in config['roles'].items():
    target = Path(entry['root']) / 'workspace'
    if not target.is_dir():
        continue
    link = agents / name / 'workspace'
    link.parent.mkdir(parents=True, exist_ok=True)
    # A previous runtime may have created a real directory here.  It is not a
    # valid broker alias: the controller would see mixed canonical roots and
    # refuse confinement. Preserve it for recovery before creating the alias.
    if link.is_symlink():
        if link.resolve(strict=False) == target.resolve(strict=False):
            continue
        link.unlink()
    elif link.exists():
        import time
        preserved = link.with_name('workspace.preserved-' + str(time.time_ns()))
        link.rename(preserved)
    link.symlink_to(target)
PY
cp "$SOURCE/README.md" "$RUNTIME/README.md" 2>/dev/null || true
ln -sfn "$SOURCE/import" "$RUNTIME/import"
cp "$SOURCE/start" "$RUNTIME/start"
# The copied launcher must point its universe root at the local runtime, not at
# the source path (and not at a guessed basename under the CPFS universe tree).
sed -i "s#^U=.*#U=\"$RUNTIME\"#" "$RUNTIME/start"
# The copied launcher must authorize the explicitly configured donor roots.
# Never retain the source universe's previous donor path.
sed -i "s#^export GEWU_EXTERNAL_ROLE_ROOTS=.*#export GEWU_EXTERNAL_ROLE_ROOTS=\"$DONOR\"#" "$RUNTIME/start"
# The runtime is owned by the controller UID; configuration is readable by it.
mkdir -p "$RUNTIME/.local/share" "$RUNTIME/.state" "$RUNTIME/.cache" "$RUNTIME/.tmp"
chown -R nobody:nogroup "$RUNTIME/.config" "$RUNTIME/workspaces" "$RUNTIME/.local" "$RUNTIME/.cache" "$RUNTIME/.tmp"
# Operator service descriptors and their parent directories must remain
# root-owned; role roots are deliberately owned by the controller/role UIDs.
# Never recursively reassign the shared state: it contains private operator
# receipts as well as controller transcripts. Restore only controller role data.
for role_state in "$RUNTIME/.state/gewu-multiverse"/author-[0-9]* \
                  "$RUNTIME/.state/gewu-multiverse"/evaluator-[0-9]* \
                  "$RUNTIME/.state/gewu-multiverse/curator"; do
  [ ! -d "$role_state" ] || chown -R nobody:nogroup "$role_state"
done
chown root:root "$RUNTIME/.state" \
  "$RUNTIME/.state/gewu-multiverse/role-broker" \
  "$RUNTIME/.state/gewu-multiverse/review-dispatcher" \
  "$RUNTIME/.state/gewu-multiverse/author-selftest" \
  "$RUNTIME/.state/gewu-multiverse/command-watchdog"
# The controller creates one private state directory and run records per role.
# Keep the service descriptors root-owned, but leave the shared state root
# writable by the dropped controller UID; otherwise every session fails before
# its transcript can be created.
chown nobody:nogroup "$RUNTIME/.state/gewu-multiverse"
chmod 700 "$RUNTIME/.state/gewu-multiverse"
chmod 755 "$RUNTIME/.state" "$RUNTIME/.state/gewu-multiverse"
for service in role-broker review-dispatcher author-selftest command-watchdog; do
  descriptor="$RUNTIME/.state/gewu-multiverse/$service/config.json"
  chown -R root:root "$(dirname "$descriptor")"
  chmod 600 "$descriptor"
  chmod 755 "$(dirname "$descriptor")"
done
# The controller runs as nobody and must read the non-secret broker descriptor
# to route its commands. Keep it root-owned/non-writable, but searchable by the
# designated controller; mode 0600 makes every run silently look unconfined.
chmod 644 "$RUNTIME/.state/gewu-multiverse/role-broker/config.json"
chown root:root "$RUNTIME/.config/science-evaluation/queue.json" \
  "$RUNTIME/.config/science-evaluation/registry.json"
chmod 600 "$RUNTIME/.config/science-evaluation/queue.json" \
  "$RUNTIME/.config/science-evaluation/registry.json"
mkdir -p "$RUNTIME/.state/gewu-multiverse/evaluation-queue"
chown root:root "$RUNTIME/.state/gewu-multiverse/evaluation-queue"
chmod 755 "$RUNTIME/.state/gewu-multiverse/evaluation-queue"
# Keep directories searchable by the dropped controller UID while restricting
# configuration files themselves.  A glob over the agents directory would
# otherwise chmod the directory to 0600, making instruction.md unreadable.
find "$RUNTIME/.config/gewu-multiverse" "$RUNTIME/.config/science-evaluation" \
  -type d -exec chmod 700 {} + 2>/dev/null || true
find "$RUNTIME/.config/gewu-multiverse" "$RUNTIME/.config/science-evaluation" \
  -type f -exec chmod 600 {} + 2>/dev/null || true
backup() {
  # Archives contain controller credentials as well as public trajectories.
  # Do not inherit an interactive shell's world-readable umask.
  umask 077
  chmod 700 "$BACKUP_DIR"
  (
    # First, periodic and exit requests share one writer. A slow CPFS backup
    # must not overlap another archive or block controller startup.
    flock -n 8 || exit 0
    local stamp archive pending code
    stamp=$(date -u +%Y%m%dT%H%M%S%N)-${BASHPID}
    archive="$BACKUP_DIR/runtime-$stamp.tar.gz"
    pending="$archive.partial"
    code=0
    tar --exclude='*.sock' --exclude='*.pid' -czf "$pending" -C "$(dirname "$RUNTIME")" "$(basename "$RUNTIME")" || code=$?
    # tar 1 means files changed during a live read. Retain it with an explicit
    # receipt, never advertise this as a transactional SQLite snapshot.
    if [[ "$code" -le 1 ]]; then
      mv -- "$pending" "$archive"
      printf 'archive=%s\ntar_exit_code=%s\nconsistency=live-best-effort-not-transactional\n' "$(basename "$archive")" "$code" > "$archive.status"
    else
      printf 'tar_exit_code=%s\nstatus=failed-partial-not-published\n' "$code" > "$pending.status"
    fi
  ) 8>>"$BACKUP_DIR/archive.lock"
}
backup_pid=''
monitor_pid=''
universe_pid=''
cleanup() {
  if [ -n "$universe_pid" ]; then
    kill -TERM "$universe_pid" 2>/dev/null || true
    wait "$universe_pid" 2>/dev/null || true
  fi
  if [ -n "$monitor_pid" ]; then
    kill -TERM "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  fi
  if [ -n "$backup_pid" ]; then kill "$backup_pid" 2>/dev/null || true; fi
  backup &
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
MONITOR_PORT=${GEWU_MONITOR_PORT:-8765}
GEWU_UNIVERSE_ROOT="$RUNTIME" GEWU_MONITOR_PORT="$MONITOR_PORT" \
  "$PY" "$W/gewu-multiverse/deploy/science/universe_monitor.py" \
  > "$RUNTIME/.state/gewu-multiverse/universe-monitor.log" 2>&1 &
monitor_pid=$!
"$PY" - "$MONITOR_PORT" "$monitor_pid" <<'PY_MONITOR_CHECK'
import json, os, sys, time, urllib.request
port, pid = sys.argv[1], int(sys.argv[2])
url = 'http://127.0.0.1:' + port + '/api/state'
deadline = time.monotonic() + 10
while True:
    try:
        with urllib.request.urlopen(url, timeout=1) as response:
            if response.status == 200 and isinstance(json.load(response).get('roles'), list):
                break
    except Exception:
        pass
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        raise SystemExit('Universe monitor exited before readiness')
    if time.monotonic() >= deadline:
        raise SystemExit('Universe monitor did not become ready')
    time.sleep(0.1)
PY_MONITOR_CHECK
# Never delay controller startup on a CPFS archive. The local runtime is the
# authoritative live copy; an archive is best-effort and independently timed.
backup &
( while sleep 600; do backup; done ) & backup_pid=$!
if [ -t 0 ] && [ -t 1 ]; then
  "$RUNTIME/start" "$@" </dev/tty >/dev/tty &
else
  echo 'The universe controller requires a terminal; start it from an interactive shell.' >&2
  exit 2
fi
universe_pid=$!
wait "$universe_pid"
