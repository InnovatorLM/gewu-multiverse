#!/bin/bash
# Operator-only wrapper. One task/config per invocation, guarded cleanup required.
set -euo pipefail
set +x
W=/mnt/data/zhanglinfeng/workspace
export HOME="$W/.state/harbor-home"
export XDG_CONFIG_HOME="$W/.config" XDG_STATE_HOME="$W/.state" XDG_CACHE_HOME="$W/.cache"
export TMPDIR="$W/.tmp" PYTHONDONTWRITEBYTECODE=1
export NO_PROXY="172.16.41.195,localhost,127.0.0.1${NO_PROXY:+,$NO_PROXY}"
export no_proxy="$NO_PROXY" LITELLM_LOCAL_MODEL_COST_MAP=True
umask 077
mkdir -p "$HOME" "$TMPDIR" "$W/.state/science-evaluation"
if [[ $# != 2 ]]; then
    echo 'Usage: run-acs-evaluation CONFIG_JSON REPORT_JSON' >&2
    exit 2
fi
"$W/acs-harbor-test/.venv/bin/python" - "$1" "$2" <<'PY_VALIDATE'
import json, sys
from pathlib import Path
w = Path('/mnt/data/zhanglinfeng/workspace')
cpath, report = [Path(p).resolve() for p in sys.argv[1:]]
if not all(p.is_relative_to(w) for p in (cpath, report)):
    raise SystemExit('Configuration and report must be workspace-local')
c = json.loads(cpath.read_text())
if c.get('n_attempts') != 1 or c.get('n_concurrent_trials') != 1 or c.get('retry', {}).get('max_retries') != 0:
    raise SystemExit('Require one attempt, concurrency one, zero automatic retries')
for p in [Path(c['jobs_dir']).resolve(), Path(c['environment']['kwargs']['kubeconfig']).resolve()]:
    if not p.is_relative_to(w):
        raise SystemExit('Job and kubeconfig paths must be workspace-local')
for dataset in c.get('datasets', []):
    if not Path(dataset['path']).resolve().is_relative_to(w):
        raise SystemExit('Task datasets must be workspace-local')
# Check current cluster state rather than trusting a historical successful run.
# Inspect only the configured Secret; never log or materialize its credentials.
import base64
from kubernetes import client, config
kw = c['environment']['kwargs']
try:
    config.load_kube_config(config_file=kw['kubeconfig'])
    secret = client.CoreV1Api().read_namespaced_secret(
        kw['image_pull_secret'], kw.get('namespace', 'default'), _request_timeout=25)
    auths = json.loads(base64.b64decode(secret.data['.dockerconfigjson']))['auths']
    hosts = {kw[key].split('/', 1)[0] for key in ['runtime_image', 'verifier_image']}
    if secret.type != 'kubernetes.io/dockerconfigjson' or not hosts <= set(auths):
        raise ValueError('Pull Secret does not cover configured image registries')
except Exception:
    raise SystemExit('ACR preflight failed: configured pull Secret is unavailable or does not cover image registries') from None
PY_VALIDATE
# Original credentials remain 0600; no copying to authors or task repositories.
source "$W/.config/llm/dawnfm.env"
exec "$W/acs-harbor-test/.venv/bin/python" \
  "$W/.agents/skills/acs-harbor-eval/scripts/run_guard.py" \
  --config "$1" --out "$2" --harbor "$W/acs-harbor-test/.venv/bin/harbor"
